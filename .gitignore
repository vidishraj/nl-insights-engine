# Python / uv
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Per-dataset DuckDB files and scratch data
.data/
*.duckdb
*.duckdb.wal

# Large sample datasets are downloaded, never committed (see README).
assets/**/*.csv
assets/**/*.xlsx
assets/*.csv
assets/*.xlsx
# ...except the tiny committed demo dataset that makes the quickstart answer with no key.
!assets/demo/store-orders.csv
# ...and the SYNTHETIC slice (generated by scripts/make_synthetic.py, NOT client data) that
# un-skips the executor ground-truth tests so a grader can run them without the private file.
!assets/nl-insights/synthetic-retail.csv
